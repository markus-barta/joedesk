{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inspr:joe:fleet-config:v1",
  "title": "JoeDesk Fleet Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "rev", "updatedAt", "mode", "quota", "desks", "cadence", "amy", "mac", "tools", "secretSlots"],
  "properties": {
    "$schema": { "const": "/joe/fleet-config.schema.json" },
    "schema": { "const": "inspr.joe.fleet-config.v1" },
    "rev": { "type": "string", "pattern": "^fc-[0-9]{6}$" },
    "updatedAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "mode": { "const": "paper" },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grok", "codex", "behavior"],
      "properties": {
        "grok": { "$ref": "#/$defs/reserve" },
        "codex": { "$ref": "#/$defs/reserve" },
        "behavior": {
          "type": "object",
          "additionalProperties": false,
          "required": ["green", "amber", "red"],
          "properties": {
            "green": { "const": "run_normally" },
            "amber": { "enum": ["slow_nonessential", "park_nonessential"] },
            "red": { "const": "park_nonessential" }
          }
        }
      }
    },
    "desks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxBusyDesks", "stage0", "keep"],
      "properties": {
        "maxBusyDesks": { "type": "integer", "minimum": 1, "maximum": 32 },
        "stage0": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capEur"],
          "properties": { "capEur": { "type": "number", "minimum": 0, "maximum": 1000000 } }
        },
        "keep": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,15}$" }
        }
      }
    },
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeZone", "usOpenArm", "deskWatch", "darwin", "quotaGovernor", "wakeWindows"],
      "properties": {
        "timeZone": { "const": "Europe/Vienna" },
        "usOpenArm": { "$ref": "#/$defs/hhmm" },
        "deskWatch": { "$ref": "#/$defs/routineId" },
        "darwin": { "$ref": "#/$defs/routineId" },
        "quotaGovernor": { "$ref": "#/$defs/routineId" },
        "wakeWindows": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "days", "from", "until", "desks"],
            "properties": {
              "id": { "$ref": "#/$defs/routineId" },
              "days": {
                "type": "array",
                "minItems": 1,
                "maxItems": 7,
                "uniqueItems": true,
                "items": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }
              },
              "from": { "$ref": "#/$defs/hhmm" },
              "until": { "$ref": "#/$defs/hhmm" },
              "desks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/routineId" }
              }
            }
          }
        }
      }
    },
    "amy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routines"],
      "properties": {
        "routines": {
          "type": "object",
          "additionalProperties": false,
          "required": ["morning", "review", "close"],
          "properties": {
            "morning": { "$ref": "#/$defs/label" },
            "review": { "$ref": "#/$defs/label" },
            "close": { "$ref": "#/$defs/label" }
          }
        }
      }
    },
    "mac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shared", "knobs"],
      "properties": {
        "shared": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configPath", "docsPath"],
          "properties": {
            "configPath": { "$ref": "#/$defs/path" },
            "docsPath": { "$ref": "#/$defs/path" }
          }
        },
        "knobs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["syncMode"],
          "properties": { "syncMode": { "const": "read_on_revision" } }
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statusSource", "entries"],
      "properties": {
        "statusSource": { "const": "/joe/data.json" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/routineId" },
              "label": { "$ref": "#/$defs/label" }
            }
          }
        }
      }
    },
    "secretSlots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agenix", "janus"],
      "properties": {
        "agenix": { "$ref": "#/$defs/secretRefs" },
        "janus": { "$ref": "#/$defs/secretRefs" }
      }
    }
  },
  "$defs": {
    "reserve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reservePct"],
      "properties": { "reservePct": { "type": "integer", "minimum": 0, "maximum": 100 } }
    },
    "hhmm": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
    "routineId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[ -~]+$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^(?:~/|/)[ -~]+$" },
    "secretRefs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$" }
    }
  }
}
