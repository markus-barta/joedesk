{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hsb1.lan/joe/data.schema.json",
  "title": "Joe household desk snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedAt", "mode", "currency", "source", "safety", "desks", "totals"],
  "properties": {
    "schema": { "const": "inspr.joe.household.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "mode": { "const": "PAPER" },
    "currency": { "const": "EUR" },
    "brokerAccount": { "$ref": "#/$defs/brokerAccount" },
    "pnlSources": {
      "type": "object",
      "description": "Evidence for DAY and OPEN. An available source requires finite values for every desk and totals; an unavailable source requires null values.",
      "additionalProperties": false,
      "properties": {
        "day": { "$ref": "#/$defs/dayPnlSource" },
        "open": { "$ref": "#/$defs/openPnlSource" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "revision": { "type": ["string", "null"] }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["halt", "haltReason", "staleAfterSeconds", "gateway"],
      "properties": {
        "halt": { "type": "boolean" },
        "haltReason": { "type": ["string", "null"] },
        "staleAfterSeconds": { "type": "integer", "minimum": 1 },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "detail", "lastSeenAt"],
          "properties": {
            "status": { "enum": ["ok", "degraded", "down"] },
            "detail": { "type": ["string", "null"] },
            "lastSeenAt": { "type": ["string", "null"], "format": "date-time" }
          }
        }
      }
    },
    "desks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/desk" }
    },
    "totals": { "$ref": "#/$defs/money" },
    "positions": {
      "type": "array",
      "items": { "$ref": "#/$defs/position" }
    }
  },
  "$defs": {
    "dayPnlSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "currency", "scope", "observedAt", "periodStart", "detail"],
      "properties": {
        "status": { "enum": ["available", "unavailable"] },
        "method": { "enum": ["ib-daily-pnl", "sod-virtual-equity", null] },
        "currency": { "const": "EUR" },
        "scope": { "const": "virtual-desks" },
        "observedAt": { "type": ["string", "null"], "format": "date-time" },
        "periodStart": { "type": ["string", "null"], "format": "date-time" },
        "detail": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[ -~]+$" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "available" } }, "required": ["status"] },
          "then": {
            "properties": {
              "method": { "enum": ["ib-daily-pnl", "sod-virtual-equity"] },
              "observedAt": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "method": { "const": "sod-virtual-equity" } }, "required": ["method"] },
          "then": { "properties": { "periodStart": { "type": "string" } } }
        }
      ]
    },
    "openPnlSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "currency", "scope", "observedAt", "detail"],
      "properties": {
        "status": { "enum": ["available", "unavailable"] },
        "method": { "enum": ["ib-unrealized-pnl", null] },
        "currency": { "const": "EUR" },
        "scope": { "const": "virtual-desks" },
        "observedAt": { "type": ["string", "null"], "format": "date-time" },
        "detail": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[ -~]+$" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "available" } }, "required": ["status"] },
          "then": {
            "properties": {
              "method": { "const": "ib-unrealized-pnl" },
              "observedAt": { "type": "string" }
            }
          }
        }
      ]
    },
    "brokerAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equity", "currency", "observedAt", "scope", "status"],
      "properties": {
        "equity": { "type": ["number", "null"] },
        "currency": { "const": "EUR" },
        "observedAt": { "type": "string", "format": "date-time" },
        "scope": { "const": "paper-account-including-keep" },
        "status": { "enum": ["available", "unavailable"] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "available" } }, "required": ["status"] },
          "then": { "properties": { "equity": { "type": "number" } } }
        }
      ]
    },
    "backfillInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromInclusive", "toExclusive"],
      "properties": {
        "fromInclusive": { "type": "string", "format": "date-time" },
        "toExclusive": { "type": "string", "format": "date-time" }
      }
    },
    "backfillPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "realizedPnl"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "realizedPnl": { "type": "number" }
      }
    },
    "backfillCapturedSubtotal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["realizedPnl", "currency", "executionCount", "commissionCount", "fromInclusive", "throughInclusive"],
      "properties": {
        "realizedPnl": { "type": ["number", "null"] },
        "currency": { "enum": ["USD", "EUR", null] },
        "method": { "enum": ["captured-fifo-matched-roundtrips", null] },
        "executionCount": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "commissionCount": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "fromInclusive": { "type": "string", "format": "date-time" },
        "throughInclusive": { "type": "string", "format": "date-time" },
        "points": {
          "type": "array",
          "maxItems": 2048,
          "items": { "$ref": "#/$defs/backfillPoint" }
        },
        "pointsTruncated": { "type": "boolean" }
      },
      "dependentRequired": {
        "points": ["pointsTruncated"],
        "pointsTruncated": ["points"]
      },
      "allOf": [
        {
          "if": { "properties": { "realizedPnl": { "type": "number" } }, "required": ["realizedPnl"] },
          "then": { "properties": { "currency": { "enum": ["USD", "EUR"] } } }
        },
        {
          "if": { "properties": { "realizedPnl": { "type": "null" } }, "required": ["realizedPnl"] },
          "then": { "properties": { "method": { "type": "null" } } }
        }
      ]
    },
    "backfillCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "completeIntervalCount", "knownIntervalCount", "gapCount", "firstGap"],
      "properties": {
        "target": { "$ref": "#/$defs/backfillInterval" },
        "completeIntervalCount": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "knownIntervalCount": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "gapCount": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "firstGap": {
          "oneOf": [
            { "$ref": "#/$defs/backfillInterval" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "gapCount": { "const": 0 } }, "required": ["gapCount"] },
          "then": { "properties": { "firstGap": { "type": "null" } } },
          "else": { "properties": { "firstGap": { "$ref": "#/$defs/backfillInterval" } } }
        }
      ]
    },
    "backfill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "fullTotalAvailable", "capturedSubtotal", "coverage", "missingOpeningLotCount", "orphanCommissionCount"],
      "properties": {
        "status": { "enum": ["BEST_AVAILABLE", "COMPLETE"] },
        "fullTotalAvailable": { "type": "boolean" },
        "capturedSubtotal": { "$ref": "#/$defs/backfillCapturedSubtotal" },
        "coverage": { "$ref": "#/$defs/backfillCoverage" },
        "missingOpeningLotCount": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "orphanCommissionCount": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      },
      "allOf": [
        {
          "if": { "properties": { "fullTotalAvailable": { "const": true } }, "required": ["fullTotalAvailable"] },
          "then": {
            "properties": {
              "status": { "const": "COMPLETE" },
              "coverage": { "properties": { "gapCount": { "const": 0 } } },
              "missingOpeningLotCount": { "const": 0 },
              "orphanCommissionCount": { "const": 0 }
            }
          }
        }
      ]
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equity", "dayPnl", "totalPnl"],
      "properties": {
        "equity": { "type": ["number", "null"] },
        "dayPnl": { "type": ["number", "null"] },
        "totalPnl": { "type": ["number", "null"] },
        "openPnl": { "type": ["number", "null"] }
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodStart", "method", "detail"],
      "properties": {
        "periodStart": { "type": "string", "format": "date-time" },
        "method": { "const": "execution-fifo-net-current-fx" },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[ -~]+$"
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desk", "symbol"],
      "properties": {
        "desk": { "enum": ["j", "joe", "joel"] },
        "symbol": { "type": "string", "minLength": 1 },
        "side": { "enum": ["Long", "Short", "long", "short"] },
        "quantity": { "type": ["number", "null"] },
        "mark": { "type": ["number", "null"] },
        "marketValue": { "type": ["number", "null"] },
        "dayPnl": { "type": ["number", "null"] },
        "openPnl": { "type": ["number", "null"] },
        "updatedAt": { "type": ["string", "null"], "format": "date-time" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "accountingScope": { "enum": ["stage0", "legacy"] }
      }
    },
    "desk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "state", "stateSince", "action", "learning", "money", "issues"],
      "properties": {
        "id": { "enum": ["j", "joe", "joel"] },
        "label": { "type": "string", "minLength": 1 },
        "state": { "enum": ["working", "sit-out", "stuck"] },
        "stateSince": { "type": ["string", "null"], "format": "date-time" },
        "action": { "type": "string", "minLength": 1 },
        "learning": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "headline", "detail", "iteration"],
          "properties": {
            "status": { "enum": ["learning", "iterating", "steady", "blocked"] },
            "headline": { "type": "string", "minLength": 1 },
            "detail": { "type": "string", "minLength": 1 },
            "iteration": { "type": ["integer", "null"], "minimum": 0 }
          }
        },
        "money": { "$ref": "#/$defs/money" },
        "accounting": { "$ref": "#/$defs/accounting" },
        "backfill": { "$ref": "#/$defs/backfill" },
        "historyBasis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "heartbeatAt": { "type": ["string", "null"], "format": "date-time" },
        "updatedAt": { "type": ["string", "null"], "format": "date-time" },
        "tradeCount": { "type": ["integer", "null"], "minimum": 0 },
        "positions": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/position" }
            ]
          }
        },
        "issues": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "id": { "enum": ["joe", "joel"] } }, "required": ["id"] },
          "then": { "not": { "required": ["backfill"] } }
        }
      ]
    }
  }
}
