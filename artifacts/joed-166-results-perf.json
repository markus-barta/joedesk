    "entry": "scripts/browser/results-budget.mjs: runResultsBudget with unchanged CI_GUARD, fixture, eleven clicks and remeasurement policy",
    "source": "import { pathToFileURL } from 'node:url';\nimport { writeFileSync } from 'node:fs';\nconst [root, output, mode = 'budget'] = process.argv.slice(2);\nconst mod = name => import(pathToFileURL(`${root}/scripts/browser/${name}.mjs`));\nconst { launch, openPage } = await mod('cdp');\nconst { startBoard, ACTOR } = await mod('board');\nconst { runResultsBudget, serveResults } = await mod('results-budget');\nconst { CI_GUARD } = await mod('budget');\nconst browser = await launch({ commandTimeout: 60000 });\nconst boards = [], checks = [], details = [];\ntry {\n  console.log(JSON.stringify({ root, runnerPid: process.pid, engine: await browser.send('Browser.getVersion'), processes: await browser.send('SystemInfo.getProcessInfo') }));\n  const page = await openPage(browser, { headers: { 'x-auth-request-user': ACTOR } });\n  if (mode.includes('trace')) await browser.send('Tracing.start', { categories: 'devtools.timeline,disabled-by-default-devtools.timeline.stack,v8.execute', transferMode: 'ReturnAsStream' });\n  if (mode === 'profile') {\n    await page.s('Profiler.enable');\n    await page.s('Profiler.setSamplingInterval', { interval: 100 });\n  }\n  const tracedServe = async (record, board) => {\n    const close = await serveResults(browser, page, board, record);\n    return async () => {\n      \n      await close();\n    };\n  };\n  let profileNo = 0;\n  if (mode.includes('wide')) await page.s('Page.addScriptToEvaluateOnNewDocument', { source: `addEventListener('DOMContentLoaded', () => document.documentElement.style.setProperty('--font', 'Verdana, \\\"DejaVu Sans\\\", sans-serif'))` });\n  const evaluate = page.evaluate;\n  page.evaluate = async (...args) => {\n    if (mode === 'profile' && args[0] === 'window.__joedesk.timings.length = 0') await page.s('Profiler.start');\n    const result = await evaluate(...args);\n    if (mode === 'profile' && args[0].includes('timings: window.__joedesk.timings.slice()')) {\n      const { profile } = await page.s('Profiler.stop');\n      writeFileSync(`${output}.${++profileNo}.cpuprofile`, JSON.stringify(profile));\n    }\n    if (args[0].includes('timings: window.__joedesk.timings.slice()')) details.push(result.timings);\n    return result;\n  };\n  const rows = await runResultsBudget({ page, newBoard: async options => { const b = await startBoard(options); boards.push(b); return b; },\n    check: (ac, name, ok, detail) => { checks.push({ ac, name, ok, detail }); }, limits: CI_GUARD, serve: tracedServe });\n  if (mode.includes('trace')) {\n    const completed = new Promise(resolve => browser.on(m => { if (m.method === 'Tracing.tracingComplete') resolve(m.params.stream); }));\n    await browser.send('Tracing.end');\n    const stream = await completed;\n    let data = '';\n    while (true) { const part = await browser.send('IO.read', { handle: stream }); data += part.data; if (part.eof) break; }\n    await browser.send('IO.close', { handle: stream });\n    writeFileSync(`${output}.trace.json`, data);\n  }\n  writeFileSync(output, JSON.stringify({ root, mode, rows, checks, details, errors: page.errors }, null, 2) + '\\n');\n  console.log(JSON.stringify({ rows, errors: page.errors, passed: checks.filter(c => c.ok).length, total: checks.length }));\n} finally {\n  await browser.close();\n  for (const board of boards) await board.close();\n  console.log('Closed browser and all owned boards');\n}\n",
    "measurement_policy": "Three complete, sequential r38 / r39-before / r39-after rounds; report every sample and median, without choosing favorable runs."
  },
  "conclusions": {
    "verified_added_cost": "JOED-151 b543a6f timeMarks resolved every calendar midnight before rejecting unmarked dates (379 calls for 12 annual marks). Original CPU profile: timeMarks inclusive 4.76 ms over three viewport click sequences.",
    "fix": "Visit only dates drawn by the chart; precompute each recorded close coordinate in the existing worker index and transfer its Float64Array, avoiding main-thread timezone conversion for close points. The transfer list already enumerates typed close columns.",
    "ci_limitation": "The reported Linux CI doubling was not reproduced on macOS (also probed Chrome 149). Optimizing dates improves the cold All switch, not the worst switch dominated by calendar/trade layout. The target of matching release 38 worst-switch ratios is not demonstrated; JOED-166 must remain open pending coordinator investigation/CI.",
    "behavior": "Money, dates, marks, copy, layout, routes and deep links are preserved; no contract/budget/fixture edits. Equivalence tests exercise leap dates, both DST transitions, exact 16/120-day thresholds and midnight boundaries; transfer test checks 23/25-hour close intervals and curve coordinates."
