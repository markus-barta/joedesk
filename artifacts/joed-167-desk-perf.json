  "findings": [
    {
      "location": "public/joe/account.js:466; public/joe/account-model.js:223",
      "cause": "The new whole-account overview walks roughly 2200 daily closes on a full draw. Calendar gap checks repeatedly converted every date to its next calendar day. Instrumented full account draws took 3.4–3.6 ms on the worst desktop data renders; a finer draw profile attributed about 2 ms to the overview.",
      "fix": "Bound calendar-successor memoization to 4096 dates. Reuse the ResizeObserver chart size and overview handle geometry, including on complete redraws."
    },
    {
      "location": "public/joe/app.js:89",
      "cause": "Comparing generated SVG markup to browser-serialized innerHTML misses equivalent markup, rebuilding the larger header and forcing a fresh fit measurement.",
      "fix": "Use the existing structural patch helper and avoid unchanged status attribute writes."
    },
    {
      "location": "public/joe/desk.js:1246",
      "cause": "History-triggered Desk renders reformatted the unchanged large position list; each fresh row also repeated identical value formatting for mobile and desktop.",
      "fix": "Reuse a fresh section only for the same snapshot, selected row identities, receipt and NY day; retain uncached state/age updates. Format duplicate values and timestamps once per row/render."
    },
    {
      "location": "public/joe/app.js:361",
      "cause": "The typography observer queried matchMedia twice per text node after large patches; CPU sampling put matchMedia among the largest script costs.",
      "fix": "Read the viewport once per synchronous observer delivery."
    }
  ],
